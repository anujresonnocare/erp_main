<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_department_form_inherit_resonnocare_clinic" model="ir.ui.view">
        <field name="name">hr.department.form.inherit.resonnocare.clinic</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="groups_id" eval="[(5, 0, 0)]"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="clinic_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
