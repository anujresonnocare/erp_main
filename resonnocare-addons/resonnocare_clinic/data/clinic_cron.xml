<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- Scheduled Action: Activate Clinics on Go-Live Date -->
        <record id="ir_cron_activate_go_live_clinics" model="ir.cron">
            <field name="name">Resonnocare: Activate Go-Live Clinics</field>
            <field name="model_id" ref="model_resonnocare_clinic"/>
            <field name="state">code</field>
            <field name="code">model._cron_activate_go_live_clinics()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>