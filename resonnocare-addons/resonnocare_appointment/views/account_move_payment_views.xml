<odoo>
    <record id="view_account_payment_register_form_inherit_mode" model="ir.ui.view">
    <field name="name">account.payment.register.form.inherit.mode</field>
    <field name="model">account.payment.register</field>
    <field name="inherit_id" ref="account.view_account_payment_register_form"/>
    <field name="arch" type="xml">

        <xpath expr="//group[@name='group1']" position="after">
            <group string="Payment Details" col="4">

                <!-- ============ MASTER ============ -->
                <field name="payment_mode" required="1"/>

                <!-- ============ POS ============ -->
                <field name="sub_mode_pos"
                       invisible="payment_mode != 'POS'"
                       required="payment_mode == 'POS'"/>

                <field name="pay_type_upi"
                       invisible="not is_pos_upi"
                       required="is_pos_upi"/>

                <field name="pay_type_card"
                       invisible="not is_pos_card"
                       required="is_pos_card"/>

                <field name="pay_type_link"
                       invisible="not is_pos_link"
                       required="is_pos_link"/>

                <!-- ============ ONLINE ============ -->
                <field name="sub_mode_online"
                       invisible="payment_mode != 'Online'"
                       required="payment_mode == 'Online'"/>

                <field name="reference_no"
                       invisible="payment_mode not in ('Online',)"
                       required="payment_mode == 'Online'"/>

                <field name="payment_date"
                       invisible="payment_mode not in ('Online',)"
                       required="payment_mode == 'Online'"/>

                <!-- ============ CHEQUE ============ -->
                <field name="cheque_bank_name"
                       invisible="payment_mode != 'Cheque'"
                       required="payment_mode == 'Cheque'"/>

                <field name="cheque_no"
                       invisible="payment_mode not in ('Cheque','EMI')"
                       required="payment_mode in ('Cheque','EMI')"/>

                <field name="cheque_date"
                       invisible="payment_mode not in ('Cheque','EMI')"
                       required="payment_mode in ('Cheque','EMI')"/>

                <!-- ============ EMI ============ -->
                <field name="sub_mode_emi"
                       invisible="payment_mode != 'EMI'"
                       required="payment_mode == 'EMI'"/>

                <field name="partner_name"
                       invisible="payment_mode != 'EMI'"
                       required="payment_mode == 'EMI'"/>

                <field name="scheme_name"
                       invisible="payment_mode != 'EMI'"/>

            </group>
        </xpath>
    </field>
</record>

    <!-- Payment Form View -->
    <record id="view_account_payment_form_inherit_mode" model="ir.ui.view">
    <field name="name">account.payment.form.inherit.mode</field>
    <field name="model">account.payment</field>
    <field name="inherit_id" ref="account.view_account_payment_form"/>
    <field name="arch" type="xml">

        <xpath expr="//group" position="after">
            <group string="Extended Payment Info" col="4">
                <field name="payment_mode"/>
                <field name="sub_mode_pos"      invisible="payment_mode != 'POS'"/>
                <field name="pay_type_upi"      invisible="not (payment_mode == 'POS' and sub_mode_pos == 'UPI')"/>
                <field name="pay_type_card"     invisible="not (payment_mode == 'POS' and sub_mode_pos in ('Credit_Card','Debit_Card'))"/>
                <field name="pay_type_link"     invisible="not (payment_mode == 'POS' and sub_mode_pos == 'Pay_by_Link')"/>

                <field name="sub_mode_online"   invisible="payment_mode != 'Online'"/>
                <field name="reference_no"      invisible="payment_mode != 'Online'"/>
                <field name="payment_date"      invisible="payment_mode != 'Online'"/>

                <field name="cheque_bank_name"  invisible="payment_mode != 'Cheque'"/>
                <field name="cheque_no"         invisible="payment_mode not in ('Cheque','EMI')"/>
                <field name="cheque_date"       invisible="payment_mode not in ('Cheque','EMI')"/>

                <field name="sub_mode_emi"      invisible="payment_mode != 'EMI'"/>
                <field name="partner_name"      invisible="payment_mode != 'EMI'"/>
                <field name="scheme_name"       invisible="payment_mode != 'EMI'"/>
            </group>
        </xpath>
    </field>
</record>
</odoo>
