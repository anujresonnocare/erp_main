                            <strong>Received From:</strong>
                            <span t-out="o.partner_id.name or ''"/>
                            <span t-if="o.partner_id.patient_id"> and Patient ID <span t-out="o.partner_id.patient_id"/></span>
                            <br/>
                            <span t-out="o.partner_id.street or ''"/>
                            <span t-if="o.partner_id.street2">, <span t-out="o.partner_id.street2"/></span>
                            <span t-if="o.partner_id.city">, <span t-out="o.partner_id.city"/></span>
                            <span t-if="o.partner_id.phone">, Phone <span t-out="o.partner_id.phone"/></span>
                            <span t-if="o.partner_id.email">, Email <span t-out="o.partner_id.email"/></span>
                        </td>
                    </tr>
                    <!-- Amount -->
                    <tr>
                        <td colspan="2" style="padding:6px 12px 10px 12px;">
                            <strong>A Sum of Rs.</strong>
                            <span t-field="o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            <span t-out="o._get_receipt_amount_words()"/> Only.
                            <br/>
                            <strong>Paid For:</strong> <span t-out="o._get_receipt_paid_for_label()"/>
                        </td>
                    </tr>
                    <!-- NDNC + Signature -->
                    <tr style="border-top:1px solid #000;">
                        <td style="padding:8px 12px;border-right:1px solid #000;vertical-align:top;">
                            <div style="font-size:11px;line-height:1.4;color:#333;">
                                Notwithstanding your registration as NDNC anywhere, fully/partially blocked, you agree to receive a sales or service call from the company or its group company or associates based on the information you have provided to us.
                            </div>
                        </td>
                        <td style="padding:8px 12px;vertical-align:bottom;text-align:center;">
                            <div style="margin-top:30px;border-top:1px solid #000;display:inline-block;width:80%;"></div>
                            <div style="font-size:12px;margin-top:4px;">Authorised Signature</div>
                        </td>
                    </tr>
                    <!-- Addresses -->
                    <tr style="border-top:1px solid #000;">
                        <td style="padding:8px 12px;border-right:1px solid #000;vertical-align:top;">
                            <strong>Corporate Address:</strong><br/>
                            RESONNOCARE HEALTH-TECH PVT. LTD, 403, Office Block 'C', 4th Floor – Above Retail Block R1 &amp; R5, M3M URBANA, Sector 67, Gurugram, 122101
                            <br/>
                            <span t-if="o.company_id.phone">Phone: <span t-out="o.company_id.phone"/></span>
                        </td>
                        <td style="padding:8px 12px;vertical-align:top;">
                            <strong>Registered Address:</strong><br/>
                            <span t-out="o.company_id.partner_id.contact_address or ''"/>
                            <br/>
                            <span t-if="o.company_id.company_registry">CIN: <span t-out="o.company_id.company_registry"/></span>
                        </td>
                    </tr>
                </table>

            </div>
        </xpath>

    </template>
</odoo>