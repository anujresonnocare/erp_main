                                    <div style="font-size:12px;letter-spacing:0.5px;line-height:1.2;">Health-tech Private Limited</div>
                                </div>
                            </div>
                        </td>
                        <td style="width:50%;vertical-align:middle;padding:10px 12px;text-align:center;">
                            <div style="font-size:16px;font-weight:bold;">RECEIPT # <span style="font-size:13px;font-weight:normal;" t-out="o.name or ''"/></div>
                            <div style="font-size:13px;margin-top:4px;"><span t-out="o._get_receipt_paid_for_label()"/></div>
                        </td>
                    </tr>
                    <!-- HQ + Clinic -->
                    <tr>
                        <td style="border-top:1px solid #000;border-right:1px solid #000;padding:8px 12px;vertical-align:top;">
                            <div t-if="clinic and clinic.state_hq_name" style="font-weight:bold;"><span t-out="clinic.state_hq_name or ''"/></div>
                            <div t-if="clinic and clinic.state_hq_address"><span t-out="clinic.state_hq_address or ''"/></div>
                            <div t-if="clinic and clinic.state_gst">GSTIN: <span t-out="clinic.state_gst or ''"/></div>
                        </td>
                        <td style="border-top:1px solid #000;padding:8px 12px;vertical-align:top;">
                            <div style="font-weight:bold;">Clinic Name</div>
                            <div t-out="clinic.name or ''"/>
                            <div t-out="clinic.street or ''"/>
                            <div>
                                <span t-out="clinic.city or ''"/>
                                <span t-if="clinic.state_id">, <span t-out="clinic.state_id.name"/></span>
                            </div>
                            <div>Phone: <span t-out="(clinic.company_id.phone if clinic and clinic.company_id else '') or ''"/></div>
                        </td>
                    </tr>
                    <!-- Date + Mode -->
                    <tr style="border-top:2px solid #000;border-bottom:2px solid #000;background:#f5f5f5;">
                        <td style="padding:6px 12px;border-right:1px solid #000;"><strong>Date:</strong> <span t-field="o.date"/></td>
                        <td style="padding:6px 12px;text-align:right;"><strong><span t-out="o._get_receipt_mode_label()"/></strong></td>
                    </tr>
                    <!-- Received From -->
                    <tr>
