<odoo>
    <record id="view_resonnocare_ear_mould_form" model="ir.ui.view">
        <field name="name">resonnocare.ear.mould.form.form</field>
        <field name="model">resonnocare.ear.mould.form</field>
        <field name="arch" type="xml">
            <form string="Hearing Aid / Ear Mould Order Form">
                <header>
                    <button name="action_preview_ear_mould_form" type="object" string="Preview" class="btn-secondary"/>
                    <button name="action_print_ear_mould_form" type="object" string="Download PDF" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="order_date"/>
                            <field name="order_type" required="1"/>
                            <field name="appointment_id" readonly="1"/>
                            <field name="device_line_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="patient_id" readonly="1"/>
                            <field name="patient_code" readonly="1"/>
                            <field name="can_number" readonly="1"/>
                            <field name="clinic_id" readonly="1"/>
                            <field name="audiologist_id" readonly="1"/>
                            <field name="first_time_user"/>
                            <field name="most_important"/>
                        </group>
                    </group>

                    <group string="Vendor / Clinic">
                        <field name="vendor_name_address"/>
                        <field name="clinic_name_address"/>
                    </group>

                    <group string="Patient Information">
                        <group>
                            <field name="patient_age_sex"/>
                        </group>
                    </group>

                    <group string="Hearing Threshold Level">
                        <group string="Right">
                            <field name="right_250"/>
                            <field name="right_500"/>
                            <field name="right_1000"/>
                            <field name="right_2000"/>
                            <field name="right_3000"/>
                            <field name="right_4000"/>
                            <field name="right_8000"/>
                        </group>
                        <group string="Left">
                            <field name="left_250"/>
                            <field name="left_500"/>
                            <field name="left_1000"/>
                            <field name="left_2000"/>
                            <field name="left_3000"/>
                            <field name="left_4000"/>
                            <field name="left_8000"/>
                        </group>
                    </group>

                    <group string="Mould Section">
                        <group string="Right">
                            <field name="right_ear_canal_length"/>
                            <field name="right_mould_vent"/>
                            <field name="right_vent_size"/>
                        </group>
                        <group string="Left">
                            <field name="left_ear_canal_length"/>
                            <field name="left_mould_vent"/>
                            <field name="left_vent_size"/>
                        </group>
                        <group>
                            <field name="mould_type" required="1"/>
                        </group>
                    </group>

                    <group string="Custom Product Section">
                        <group string="Right">
                            <field name="ha_model_name_right"/>
                            <field name="right_type"/>
                            <field name="right_vent_shape"/>
                            <field name="right_shell"/>
                            <field name="right_volume_control"/>
                            <field name="right_switch"/>
                            <field name="right_telecoil"/>
                        </group>
                        <group string="Left">
                            <field name="ha_model_name_left"/>
                            <field name="left_type"/>
                            <field name="left_vent_shape"/>
                            <field name="left_shell"/>
                            <field name="left_volume_control"/>
                            <field name="left_switch"/>
                            <field name="left_telecoil"/>
                        </group>
                    </group>

                    <group string="Remake / Modification">
                        <group>
                            <field name="remake_shell"/>
                            <field name="too_tight"/>
                            <field name="too_loose"/>
                            <field name="add_vent"/>
                            <field name="seal_vent"/>
                        </group>
                        <group>
                            <field name="make_small_as_possible"/>
                            <field name="vent_size_required"/>
                        </group>
                    </group>

                    <group string="Notes / Signature">
                        <field name="notes"/>
                        <field name="audiologist_signature_name"/>
                        <field name="is_minimum_complete" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
