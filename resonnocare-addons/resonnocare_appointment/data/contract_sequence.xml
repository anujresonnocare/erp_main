<odoo>
    <record id="seq_resonnocare_contract" model="ir.sequence">
        <field name="name">Contract ID</field>
        <field name="code">resonnocare.contract</field>
        <field name="prefix">CT/</field>
        <field name="padding">5</field>
    </record>


    <record id="emi_partner_paytm" model="resonnocare.emi.partner">
        <field name="name">Paytm</field>
        <field name="sequence">10</field>
    </record>
    <record id="emi_partner_hdfc" model="resonnocare.emi.partner">
        <field name="name">HDFC</field>
        <field name="sequence">20</field>
    </record>
    <record id="emi_partner_shopse" model="resonnocare.emi.partner">
        <field name="name">Shopse</field>
        <field name="sequence">30</field>
    </record>
    <record id="emi_partner_fibe" model="resonnocare.emi.partner">
        <field name="name">FIBE</field>
        <field name="sequence">40</field>
    </record>
    <record id="emi_partner_resonnocare" model="resonnocare.emi.partner">
        <field name="name">Resonnocare</field>
        <field name="sequence">50</field>
    </record>



    <!-- ============ Product Types ============ -->
    <record id="ptype_diagnostic" model="resonnocare.product.type">
        <field name="name">Diagnostics</field>
        <field name="code">diagnostic</field>
        <field name="sequence">10</field>
    </record>
    <record id="ptype_device" model="resonnocare.product.type">
        <field name="name">Device</field>
        <field name="code">device</field>
        <field name="sequence">20</field>
    </record>
    <record id="ptype_accessory" model="resonnocare.product.type">
        <field name="name">Accessories</field>
        <field name="code">accessory</field>
        <field name="sequence">30</field>
    </record>
    <record id="ptype_repair" model="resonnocare.product.type">
        <field name="name">Repairs</field>
        <field name="code">repair</field>
        <field name="sequence">40</field>
    </record>

    <!-- ============ Payment Types ============ -->
    <record id="paytype_regular" model="resonnocare.payment.type">
        <field name="name">Regular Payment</field>
        <field name="code">regular</field>
        <field name="sequence">10</field>
    </record>
    <record id="paytype_down" model="resonnocare.payment.type">
        <field name="name">Down Payment</field>
        <field name="code">down_payment</field>
        <field name="sequence">20</field>
    </record>
    <record id="paytype_balance" model="resonnocare.payment.type">
        <field name="name">Balance Payment</field>
        <field name="code">balance</field>
        <field name="sequence">30</field>
    </record>

    <!-- ============ Cash ============ -->
    <record id="mode_cash" model="resonnocare.payment.mode">
        <field name="name">Cash</field>
        <field name="code">cash</field>
        <field name="sequence">10</field>
        <field name="finance_approval_required" eval="False"/>
        <field name="applicable_product_type_ids" eval="[(6, 0, [ref('ptype_diagnostic'), ref('ptype_device'), ref('ptype_accessory'), ref('ptype_repair')])]"/>
        <field name="applicable_payment_type_ids" eval="[(6, 0, [ref('paytype_regular'), ref('paytype_down'), ref('paytype_balance')])]"/>
    </record>
    <record id="submode_cash_denom" model="resonnocare.payment.submode">
        <field name="mode_id" ref="mode_cash"/>
        <field name="name">Denomination Window</field>
        <field name="code">denomination</field>
        <field name="submode_group">other</field>
    </record>

    <!-- ============ POS ============ -->
    <record id="mode_pos" model="resonnocare.payment.mode">
        <field name="name">POS</field>
        <field name="code">pos</field>
        <field name="sequence">20</field>
        <field name="finance_approval_required" eval="False"/>
        <field name="applicable_product_type_ids" eval="[(6, 0, [ref('ptype_diagnostic'), ref('ptype_device'), ref('ptype_accessory'), ref('ptype_repair')])]"/>
        <field name="applicable_payment_type_ids" eval="[(6, 0, [ref('paytype_regular'), ref('paytype_down'), ref('paytype_balance')])]"/>
    </record>

    <!-- POS > UPI -->
    <record id="submode_pos_upi_dqr" model="resonnocare.payment.submode">
        <field name="mode_id" ref="mode_pos"/>
        <field name="name">UPI DQR</field>
        <field name="code">upi_dqr</field>
        <field name="submode_group">upi</field>
        <field name="needs_reference_no" eval="True"/>
    </record>
    <record id="submode_pos_upi_sqr" model="resonnocare.payment.submode">
        <field name="mode_id" ref="mode_pos"/>
        <field name="name">UPI SQR</field>
        <field name="code">upi_sqr</field>
        <field name="submode_group">upi</field>
        <field name="needs_reference_no" eval="True"/>
    </record>
    <!-- POS > Credit Card -->
    <record id="submode_pos_cc" model="resonnocare.payment.submode">
        <field name="mode_id" ref="mode_pos"/>
        <field name="name">Credit Card</field>
        <field name="code">credit_card</field>
        <field name="submode_group">card</field>
        <field name="needs_reference_no" eval="True"/>
    </record>
    <!-- POS > Debit Card -->
    <record id="submode_pos_dc" model="resonnocare.payment.submode">
        <field name="mode_id" ref="mode_pos"/>
        <field name="name">Debit Card</field>
        <field name="code">debit_card</field>
        <field name="submode_group">card</field>
        <field name="needs_reference_no" eval="True"/>
    </record>
   
    
    <!-- POS > Pay by Link -->
    <record id="submode_pos_pay_by_link" model="resonnocare.payment.submode">
        <field name="mode_id" ref="mode_pos"/>
        <field name="name">Pay by Link</field>
        <field name="code">pay_by_link</field>
        <field name="submode_group">pay_by_link</field>
        <field name="needs_reference_no" eval="True"/>
    </record>

    <!-- ============ Online ============ -->
    <record id="mode_online" model="resonnocare.payment.mode">
        <field name="name">Online</field>
        <field name="code">online</field>
        <field name="sequence">30</field>
        <field name="finance_approval_required" eval="True"/>
        <field name="applicable_product_type_ids" eval="[(6, 0, [ref('ptype_diagnostic'), ref('ptype_device'), ref('ptype_accessory'), ref('ptype_repair')])]"/>
        <field name="applicable_payment_type_ids" eval="[(6, 0, [ref('paytype_regular'), ref('paytype_down'), ref('paytype_balance')])]"/>
    </record>
    <record id="submode_online_neft" model="resonnocare.payment.submode">
        <field name="mode_id" ref="mode_online"/>
        <field name="name">NEFT</field>
        <field name="code">neft</field>
        <field name="submode_group">bank_transfer</field>
        <field name="needs_reference_no" eval="True"/>
        <field name="needs_reference_date" eval="True"/>
        <field name="needs_bank_name" eval="True"/>
    </record>
    <record id="submode_online_imps" model="resonnocare.payment.submode">
        <field name="mode_id" ref="mode_online"/>
        <field name="name">IMPS</field>
        <field name="code">imps</field>
        <field name="submode_group">bank_transfer</field>
        <field name="needs_reference_no" eval="True"/>
        <field name="needs_reference_date" eval="True"/>
        <field name="needs_bank_name" eval="True"/>
    </record>
    <record id="submode_online_rtgs" model="resonnocare.payment.submode">
        <field name="mode_id" ref="mode_online"/>
        <field name="name">RTGS</field>
        <field name="code">rtgs</field>
        <field name="submode_group">bank_transfer</field>
        <field name="needs_reference_no" eval="True"/>
        <field name="needs_reference_date" eval="True"/>
        <field name="needs_bank_name" eval="True"/>
    </record>

    <!-- ============ Cheque ============ -->
    <record id="mode_cheque" model="resonnocare.payment.mode">
        <field name="name">Cheque</field>
        <field name="code">cheque</field>
        <field name="sequence">40</field>
        <field name="finance_approval_required" eval="True"/>
        <!-- Cheque NOT applicable for diagnostics per spec -->
        <field name="applicable_product_type_ids" eval="[(6, 0, [ref('ptype_device'), ref('ptype_accessory'), ref('ptype_repair')])]"/>
        <field name="applicable_payment_type_ids" eval="[(6, 0, [ref('paytype_regular'), ref('paytype_down'), ref('paytype_balance')])]"/>
    </record>
    <record id="submode_cheque_bank" model="resonnocare.payment.submode">
        <field name="mode_id" ref="mode_cheque"/>
        <field name="name">Bank Cheque</field>
        <field name="code">bank_cheque</field>
        <field name="submode_group">other</field>
        <field name="needs_cheque" eval="True"/>
    </record>

    <!-- ============ EMI ============ -->
    <record id="mode_emi" model="resonnocare.payment.mode">
        <field name="name">EMI</field>
        <field name="code">emi</field>
        <field name="sequence">50</field>
        <field name="finance_approval_required" eval="True"/>
        <!-- EMI only for Device (and Device with accessories) -->
        <field name="applicable_product_type_ids" eval="[(6, 0, [ref('ptype_device'), ref('ptype_accessory')])]"/>
        <field name="applicable_payment_type_ids" eval="[(6, 0, [ref('paytype_regular'), ref('paytype_down'), ref('paytype_balance')])]"/>
    </record>
    <record id="submode_emi_no_cost" model="resonnocare.payment.submode">
        <field name="mode_id" ref="mode_emi"/>
        <field name="name">No Cost EMI</field>
        <field name="code">no_cost_emi</field>
        <field name="submode_group">emi</field>
        <field name="needs_cheque" eval="True"/>
        <field name="needs_emi_details" eval="True"/>
    </record>
    <record id="submode_emi_regular" model="resonnocare.payment.submode">
        <field name="mode_id" ref="mode_emi"/>
        <field name="name">Regular EMI</field>
        <field name="code">regular_emi</field>
        <field name="submode_group">emi</field>
        <field name="needs_cheque" eval="True"/>
        <field name="needs_emi_details" eval="True"/>
    </record>


</odoo>
