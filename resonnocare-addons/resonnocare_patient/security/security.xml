<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="resonnocare_appointment_rule_patient_portal" model="ir.rule">
            <field name="name">Patient Portal - Own Appointments</field>
            <field name="model_id" ref="resonnocare_appointment.model_resonnocare_appointment"/>
            <field name="domain_force">['|', ('patient_id', '=', user.partner_id.id), ('patient_id', '=', user.partner_id.parent_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="resonnocare_audiometry_result_rule_patient_portal" model="ir.rule">
            <field name="name">Patient Portal - Own Audiometry Results</field>
            <field name="model_id" ref="resonnocare_appointment.model_resonnocare_audiometry_result"/>
            <field name="domain_force">['|', ('patient_id', '=', user.partner_id.id), ('patient_id', '=', user.partner_id.parent_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
