<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="appointment_outcome_fta" model="resonnocare.appointment.outcome">
            <field name="code">FTA</field>
            <field name="outcome">Failed to Attend</field>
            <field name="meaning">Failed to Attend.</field>
            <field name="sequence">10</field>
            <field name="active">1</field>
        </record>

        <record id="appointment_outcome_hats" model="resonnocare.appointment.outcome">
            <field name="code">HATS</field>
            <field name="outcome">Hearing Aid trial Sucessful</field>
            <field name="meaning">The client has been prescribed and impressions could not be taken at this appointment. A second assessment will need to be organised.</field>
            <field name="sequence">20</field>
            <field name="active">1</field>
        </record>

        <record id="appointment_outcome_rx" model="resonnocare.appointment.outcome">
            <field name="code">Rx</field>
            <field name="outcome">Prescribed</field>
            <field name="meaning">Prescribed</field>
            <field name="sequence">30</field>
            <field name="active">1</field>
        </record>

        <record id="appointment_outcome_drref" model="resonnocare.appointment.outcome">
            <field name="code">DRREF</field>
            <field name="outcome">Referred to Doctor</field>
            <field name="meaning">An Audiologist has referred a client to the doctor and the client will be returning for a second assessment.</field>
            <field name="sequence">40</field>
            <field name="active">1</field>
        </record>

        <record id="appointment_outcome_def" model="resonnocare.appointment.outcome">
            <field name="code">DEF</field>
            <field name="outcome">Client Deferred</field>
            <field name="meaning">Where a client will benefit from hearing aids and is deferring his decision for a few months.</field>
            <field name="sequence">50</field>
            <field name="active">1</field>
        </record>

        <record id="appointment_outcome_asc" model="resonnocare.appointment.outcome">
            <field name="code">ASC</field>
            <field name="outcome">Appointment successfully completed</field>
            <field name="meaning">Appointment successful. Does not need another appointment of this kind.</field>
            <field name="sequence">60</field>
            <field name="active">1</field>
        </record>

        <record id="appointment_outcome_norm" model="resonnocare.appointment.outcome">
            <field name="code">NORM</field>
            <field name="outcome">Normal hearing</field>
            <field name="meaning">Where a client has normal hearing. Hearing Aids not warranted.</field>
            <field name="sequence">70</field>
            <field name="active">1</field>
        </record>

        <record id="appointment_outcome_ansp" model="resonnocare.appointment.outcome">
            <field name="code">ANSP</field>
            <field name="outcome">Attended No service provided</field>
            <field name="meaning">Diagnostic equipment/ computer system is not functioning, etc.</field>
            <field name="sequence">80</field>
            <field name="active">1</field>
        </record>

        <record id="appointment_outcome_user" model="resonnocare.appointment.outcome">
            <field name="code">USER</field>
            <field name="outcome">HA User</field>
            <field name="meaning">Where a client has current hearing aids and is not obtaining another one. Any future appointment for this outcome should be made as a service.</field>
            <field name="sequence">90</field>
            <field name="active">1</field>
        </record>
    </data>
</odoo>
