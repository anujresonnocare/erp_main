<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Diagnostic Item List View (Odoo 18) -->
    <record id="view_diagnostic_item_list" model="ir.ui.view">
        <field name="name">resonnocare.diagnostic.item.list</field>
        <field name="model">resonnocare.diagnostic.item</field>
        <field name="arch" type="xml">
            <list default_order="sequence">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="product_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Diagnostic Item Form View -->
    <record id="view_diagnostic_item_form" model="ir.ui.view">
        <field name="name">resonnocare.diagnostic.item.form</field>
        <field name="model">resonnocare.diagnostic.item</field>
        <field name="arch" type="xml">
            <form string="Diagnostic Item">
                <sheet>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="product_id"
                                   domain="[('type','=','service')]"
                                   options="{'no_create': False}"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <group>
                        <field name="description"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Diagnostic Items Action -->
    <record id="action_diagnostic_item" model="ir.actions.act_window">
        <field name="name">Diagnostic Tests</field>
        <field name="res_model">resonnocare.diagnostic.item</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_diagnostic_item_list"/>
        <field name="context">{}</field>
    </record>

</odoo>
