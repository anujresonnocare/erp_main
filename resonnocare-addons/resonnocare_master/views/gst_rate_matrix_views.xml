<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_resonnocare_gst_rate_matrix_tree" model="ir.ui.view">
        <field name="name">resonnocare.gst.rate.matrix.tree</field>
        <field name="model">resonnocare.gst.rate.matrix</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id"/>
                <field name="supply_type"/>
                <field name="hsn_sac_code"/>
                <field name="gst_rate"/>
                <field name="is_exempt"/>
                <field name="remarks"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_resonnocare_gst_rate_matrix_form" model="ir.ui.view">
        <field name="name">resonnocare.gst.rate.matrix.form</field>
        <field name="model">resonnocare.gst.rate.matrix</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="supply_type"/>
                            <field name="hsn_sac_code"/>
                        </group>
                        <group>
                            <field name="gst_rate"/>
                            <field name="is_exempt"/>
                            <field name="active"/>
                            <field name="remarks"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_resonnocare_gst_rate_matrix" model="ir.actions.act_window">
        <field name="name">GST Rate Matrix</field>
        <field name="res_model">resonnocare.gst.rate.matrix</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
