<odoo>
    <!-- Tree View -->
    <record id="view_appointment_outcome_tree" model="ir.ui.view">
        <field name="name">resonnocare.appointment.outcome.tree</field>
        <field name="model">resonnocare.appointment.outcome</field>
        <field name="arch" type="xml">
            <list string="Appointment Outcomes">
                <field name="code"/>
                <field name="outcome"/>
                <field name="meaning"/>
                <field name="sequence"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_appointment_outcome_form" model="ir.ui.view">
        <field name="name">resonnocare.appointment.outcome.form</field>
        <field name="model">resonnocare.appointment.outcome</field>
        <field name="arch" type="xml">
            <form string="Appointment Outcome">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="outcome"/>
                        <field name="meaning"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action to Open Appointment Outcomes -->
    <record id="action_appointment_outcome" model="ir.actions.act_window">
        <field name="name">Appointment Outcomes</field>
        <field name="res_model">resonnocare.appointment.outcome</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>