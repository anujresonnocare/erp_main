<odoo>
    <record id="view_appointment_type_form" model="ir.ui.view">
        <field name="name">resonnocare.appointment.type.form</field>
        <field name="model">resonnocare.appointment.type</field>
        <field name="arch" type="xml">
            <form string="Appointment Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sale_type"/>
                        <field name="duration"/>
                        <field name="description"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_appointment_type_tree" model="ir.ui.view">
        <field name="name">resonnocare.appointment.type.tree</field>
        <field name="model">resonnocare.appointment.type</field>
        <field name="arch" type="xml">
            <list string="Appointment Types">
                <field name="name"/>
                <field name="code"/>
                <field name="sale_type"/>
                <field name="duration"/>
                <field name="sequence"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_appointment_type" model="ir.actions.act_window">
        <field name="name">Appointment Types</field>
        <field name="res_model">resonnocare.appointment.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
