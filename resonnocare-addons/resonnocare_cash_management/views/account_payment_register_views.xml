<odoo>
    <record id="view_account_payment_register_form_inherit_cash" model="ir.ui.view">
        <field name="name">account.payment.register.form.inherit.cash</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="after">
                <div invisible="not is_cash_journal" class="mt-3">
                    <separator string="CASH BREAKDOWN"/>
                    
                    <field name="cash_note_ids" nolabel="1">
                        <!-- create="false" and delete="false" prevent adding/removing rows -->
                        <list editable="bottom" default_order="id asc" create="false" delete="false" class="table-bordered">
                            <field name="currency_id" invisible="1"/>
                            
                            <!-- The Bill Type is locked and cannot be changed -->
                            <field name="note_value" readonly="1" force_save="1" string="BILL TYPE"/>
                            
                            <!-- The user only edits Quantity -->
                            <field name="quantity" string="QUANTITY"/>
                            
                            <!-- Total calculates automatically -->
                            <field name="subtotal" readonly="1" sum="TOTAL CASH" string="TOTAL"/>
                        </list>
                    </field>
                    
                    <group>
                        <field name="cash_total_entered" readonly="1" class="fw-bold text-success"/>
                    </group>
                </div>
            </xpath>
        </field>
    </record>
</odoo>