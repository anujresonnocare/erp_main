<odoo>
    <record id="view_account_payment_form_inherit_cash" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.cash</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Cash Breakdown" invisible="journal_id.type != 'cash'">
                    <field name="cash_denomination_ids">
                        <list editable="bottom" create="false" delete="false">
                            <field name="currency_id" invisible="1"/>
                            <field name="note_value" readonly="1" force_save="1" string="BILL TYPE"/>
                            <field name="quantity" string="QUANTITY"/>
                            <field name="subtotal" sum="TOTAL CASH" string="TOTAL"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>