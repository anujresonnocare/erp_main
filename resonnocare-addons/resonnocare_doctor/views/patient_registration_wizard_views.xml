<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_patient_registration_wizard_form_inherit_doctor" model="ir.ui.view">
        <field name="name">patient.registration.wizard.form.inherit.doctor</field>
        <field name="model">resonnocare.patient.registration.wizard</field>
        <field name="inherit_id" ref="resonnocare_frontdesk.view_patient_registration_wizard_form"/>
        <field name="groups_id" eval="[(5, 0, 0)]"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='referral_source']" position="after">
                <field name="referring_doctor_id" string="Referal Doctor" invisible="referral_source != 'doctor'"/>
            </xpath>
            <xpath expr="//field[@name='referring_doctor']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>
