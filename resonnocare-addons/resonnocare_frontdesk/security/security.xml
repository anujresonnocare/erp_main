<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- Front Desk: Own Clinic's Patients Only -->
        <record id="patient_rule_front_desk" model="ir.rule">
            <field name="name">Patients: Front Desk - Own Clinic</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="groups" eval="[(4, ref('resonnocare_base.group_front_desk'))]"/>
            <field name="domain_force">[
                '|',
                ('clinic_id', '=', user.employee_id.clinic_id.id),
                ('id', '=', user.partner_id.id)
            ]</field>
        </record>

        <record id="discount_approval_request_rule_front_desk" model="ir.rule">
            <field name="name">Discount Approval Request: Front Desk Own Clinic</field>
