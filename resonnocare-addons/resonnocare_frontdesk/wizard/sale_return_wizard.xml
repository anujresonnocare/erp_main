<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_return_wizard_form" model="ir.ui.view">
        <field name="name">resonnocare.sale.return.wizard.form</field>
        <field name="model">resonnocare.sale.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Initiate Return">
                <group>
                    <field name="sale_order_id" invisible="1"/>
                    <field name="reason" placeholder="Enter reason for return / cancellation..."/>
                    <field name="courier_details" placeholder="e.g. Bluedart AWB 12345678"/>
                </group>
                <footer>
                    <button name="action_initiate_return" string="Initiate Return" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
