<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sale_return_wizard" model="ir.actions.act_window">
        <field name="name">Initiate Sale Return</field>
        <field name="res_model">resonnocare.sale.return.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_sale_order_id': active_id}</field>
    </record>

    <record id="view_order_form_return_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.return.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(resonnocare_frontdesk.action_sale_return_wizard)d" string="Initiate Return" type="action" class="btn-warning" invisible="True" groups="sales_team.group_sale_salesman"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_return_requests" type="object" class="oe_stat_button" icon="fa-undo" invisible="return_request_count == 0">
                    <field name="return_request_count" widget="statinfo" string="Returns"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
