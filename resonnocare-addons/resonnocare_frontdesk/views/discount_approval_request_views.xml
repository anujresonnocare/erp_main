<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_discount_approval_request_list" model="ir.ui.view">
        <field name="name">resonnocare.discount.approval.request.list</field>
        <field name="model">resonnocare.discount.approval.request</field>
        <field name="arch" type="xml">
            <list create="1" edit="1" delete="0">
                <field name="name"/>
                <field name="state"/>
                <field name="clinic_id"/>
                <field name="patient_id"/>
                <field name="sale_order_id"/>
                <field name="required_approval_level"/>
                <!-- <field name="discount_pct_requested"/> -->
                <field name="discount_value_requested"/>
                <field name="min_advance_required"/>
                <field name="lower_advance_requested"/>
                <field name="requested_by_id"/>
                <field name="approved_by_id"/>
                <field name="approved_on"/>
            </list>
        </field>
    </record>

    <record id="view_discount_approval_request_form" model="ir.ui.view">
        <field name="name">resonnocare.discount.approval.request.form</field>
        <field name="model">resonnocare.discount.approval.request</field>
        <field name="arch" type="xml">
            <form string="Discount-cum-Lower Advance Approval Request">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-success" groups="resonnocare_base.group_clinic_admin,resonnocare_base.group_resonnocare_super_admin" invisible="state != 'submitted'"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-danger" groups="resonnocare_base.group_clinic_admin,resonnocare_base.group_resonnocare_super_admin" invisible="state != 'submitted'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft','submitted')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state not in ('rejected','cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="sale_order_id" readonly="state != 'draft'"/>
                            <field name="clinic_id" readonly="1"/>
                            <field name="patient_id" readonly="1"/>
                            <field name="patient_code" readonly="1"/>
                            <field name="referral_source" readonly="1"/>
                            <field name="referral_doctor_name" readonly="1" invisible="referral_source != 'doctor'"/>
                        </group>
                        <group>
                            <field name="hearing_aid_left" readonly="state != 'draft'"/>
                            <field name="hearing_aid_right" readonly="state != 'draft'"/>
                            <field name="ha_brand" readonly="state != 'draft'"/>
                            <field name="no_of_ha" readonly="1"/>
                            <field name="total_ha_mrp" readonly="1"/>
                        </group>
                    </group>

                    <group string="Discount and Advance">
                        <group>
                            <field name="max_discount_pct_allowed" readonly="1"/>
                            <field name="max_discount_value_allowed" readonly="1"/>
                            <field name="discount_value_requested" readonly="1"/>
                            <field name="ha_discount_pct" readonly="state != 'draft'"/>
                            <field name="required_approval_level" readonly="1"/>
                        </group>
                        <group>
                            <field name="min_advance_required" readonly="1"/>
                            <field name="lower_advance_requested" readonly="state != 'draft'"/>
                            <field name="discount_absorbed_by_doctor" readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <group>
                        <group>
                            <field name="requested_by_id" readonly="1"/>
                            <field name="approved_by_id" readonly="1"/>
                            <field name="approved_on" readonly="1"/>
                        </group>
                        <group>
                            <field name="rejection_reason" readonly="state == 'approved'"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_discount_approval_request_search" model="ir.ui.view">
        <field name="name">resonnocare.discount.approval.request.search</field>
        <field name="model">resonnocare.discount.approval.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="clinic_id"/>
                <field name="patient_id"/>
                <field name="sale_order_id"/>
                <field name="state"/>
                <filter name="f_draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="f_submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="f_approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="f_rejected" string="Rejected" domain="[('state','=','rejected')]"/>
                <filter name="f_manager" string="Manager Level" domain="[('required_approval_level','=','manager')]"/>
                <filter name="f_admin" string="Admin Level" domain="[('required_approval_level','=','admin')]"/>
            </search>
        </field>
    </record>

    <record id="action_discount_approval_requests" model="ir.actions.act_window">
        <field name="name">Discount Requests</field>
        <field name="res_model">resonnocare.discount.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_discount_approval_request_search"/>
        <field name="context">{}</field>
    </record>
</odoo>
