<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================= -->
    <!-- Patient Search (Front Desk) -->
    <!-- ========================= -->
    <record id="view_patient_search_tree" model="ir.ui.view">
        <field name="name">res.partner.patient.search.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Patients" create="false" delete="false">
                <field name="patient_id"/>
                <field name="name"/>
                <field name="registration_date"/>
            </list>
        </field>
    </record>

    <record id="view_patient_search_form" model="ir.ui.view">
        <field name="name">res.partner.patient.search.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Patient Profile" create="false" edit="true" delete="false">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <group>
                        <field name="patient_id"/>
                        <field name="name"/>
                        <field name="gender"/>
                        <field name="birthdate_date"/>
                    </group>

                    <group>
                        <field name="street"/>
                        <field name="city"/>
                        <field name="state_id"/>
                        <field name="zip"/>
                    </group>

                    <separator string="Visit Info"/>

                    <group>
                        <field name="visit_type"/>
                        <field name="visit_reason"/>
                        <field name="referral_source"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========================= -->
    <!-- Patient Search Action -->
    <!-- ========================= -->
    <record id="action_patient_search" model="ir.actions.act_window">
        <field name="name">Search Patient</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_patient_search_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_res_partner_patient_form')})]"/>
        <field name="domain">[('is_patient','=',True), ('company_id','in',allowed_company_ids)]</field>
        <field name="context">
            {
                'create': False,
                'delete': False
            }
        </field>
    </record>

</odoo>
