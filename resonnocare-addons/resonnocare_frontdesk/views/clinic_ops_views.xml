<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Clinic Dashboard (read-only, scoped by server action) -->
    <record id="view_frontdesk_clinic_dashboard" model="ir.ui.view">
        <field name="name">frontdesk.clinic.dashboard</field>
        <field name="model">resonnocare.clinic</field>
        <field name="arch" type="xml">
            <form string="Clinic Dashboard" create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title mb-4">
                        <h1 class="mb-1">
                            <field name="name" readonly="1" class="text-break"/>
                        </h1>
                        <div class="text-muted d-flex align-items-center gap-2">
                            <field name="clinic_code" readonly="1"/>
                            <span>•</span>
                            <span>Clinic Dashboard</span>
                        </div>
                    </div>

                    <group col="2">
                        <group string="Operations Today">
                            <field name="appointments_today" readonly="1"/>
                            <field name="walkins_today" readonly="1"/>
                            <field name="patients_waiting" readonly="1"/>
                        </group>
                        <group string="Clinical Status">
                            <field name="doctors_on_duty" readonly="1"/>
                            <field name="pending_consultations" readonly="1"/>
                            <field name="followups_due_today" readonly="1"/>
                        </group>
                    </group>

                    <separator string="Clinic Overview"/>
                    <group col="2">
                        <group>
                            <field name="clinic_status" widget="badge"
                                   decoration-success="clinic_status == 'active'"
                                   decoration-warning="clinic_status == 'draft'"
                                   decoration-danger="clinic_status == 'suspended'"/>
                            <field name="clinic_type" readonly="1"/>
                        </group>
                        <group>
                            <field name="go_live_date" readonly="1"/>
                            <field name="city" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_frontdesk_clinic_dashboard" model="ir.actions.act_window">
        <field name="name">Clinic Dashboard</field>
        <field name="res_model">resonnocare.clinic</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_frontdesk_clinic_dashboard"/>
        <field name="target">current</field>
        <field name="context">
            {
                'form_view_initial_mode': 'readonly',
                'create': False,
                'edit': False,
                'delete': False
            }
        </field>
        <field name="groups_id" eval="[(4, ref('resonnocare_base.group_front_desk'))]"/>
    </record>

    <!-- Staff (read-only, clinic-scoped by record rule) -->
    <record id="view_frontdesk_clinic_staff_tree" model="ir.ui.view">
        <field name="name">hr.employee.tree.frontdesk.clinic</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="job_title"/>
                <field name="clinic_role"/>
                <field name="work_email"/>
                <field name="work_phone"/>
                <field name="department_id"/>
            </list>
        </field>
    </record>

    <record id="view_frontdesk_clinic_staff_form" model="ir.ui.view">
        <field name="name">hr.employee.form.frontdesk.clinic</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <form string="Staff Member" create="0" edit="0" delete="0">
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"
                           options="{'zoom': true, 'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="job_title" readonly="1"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Clinic Details">
                            <field name="clinic_id" readonly="1"/>
                            <field name="clinic_role" readonly="1"/>
                            <field name="department_id" readonly="1"/>
                        </group>
                        <group string="Contact Information">
                            <field name="work_email" readonly="1"/>
                            <field name="work_phone" readonly="1"/>
                            <field name="mobile_phone" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_frontdesk_clinic_staff" model="ir.actions.act_window">
        <field name="name">Staff</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_frontdesk_clinic_staff_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_frontdesk_clinic_staff_form')})]"/>
        <field name="groups_id" eval="[(4, ref('resonnocare_base.group_front_desk'))]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No staff members found</p>
            <p>Staff records are managed by HR and are read-only in Front Desk.</p>
        </field>
    </record>

    <!-- Clinic Profile (read-only, scoped by server action) -->
    <record id="view_frontdesk_clinic_profile" model="ir.ui.view">
        <field name="name">frontdesk.clinic.profile</field>
        <field name="model">resonnocare.clinic</field>
        <field name="arch" type="xml">
            <form string="Clinic Profile" create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" class="text-break"/>
                        </h1>
                        <h3 class="text-muted">
                            <field name="clinic_code" readonly="1"/>
                        </h3>
                    </div>

                    <group>
                        <group string="Clinic Information">
                            <field name="clinic_type" readonly="1"/>
                            <field name="clinic_subtype" readonly="1"/>
                            <field name="partner_name" readonly="1" invisible="clinic_type == 'coco'"/>
                            <field name="clinic_status" widget="badge"
                                   decoration-success="clinic_status == 'active'"
                                   decoration-warning="clinic_status == 'draft'"
                                   decoration-danger="clinic_status == 'suspended'"/>
                        </group>
                        <group string="Operational Details">
                            <field name="go_live_date" readonly="1"/>
                            <field name="ownership_type" readonly="1"/>
                        </group>
                    </group>

                    <group string="Location">
                        <group>
                            <field name="street" readonly="1"/>
                            <field name="street2" readonly="1"/>
                            <field name="city" readonly="1"/>
                        </group>
                        <group>
                            <field name="state_id" readonly="1"/>
                            <field name="zip" readonly="1"/>
                            <field name="country_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_frontdesk_clinic_profile" model="ir.actions.act_window">
        <field name="name">Clinic Profile</field>
        <field name="res_model">resonnocare.clinic</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_frontdesk_clinic_profile"/>
        <field name="target">current</field>
        <field name="context">
            {
                'form_view_initial_mode': 'readonly',
                'create': False,
                'edit': False,
                'delete': False
            }
        </field>
        <field name="groups_id" eval="[(4, ref('resonnocare_base.group_front_desk'))]"/>
    </record>

</odoo>
