<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================== -->
    <!-- Patient Search Action -->
    <!-- ============================== -->
    <record id="action_patient_search" model="ir.actions.act_window">
        <field name="name">Search Patient</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>

        <!-- Only patients -->
        <field name="domain">[
            ('is_patient', '=', True),
            ('company_id', 'in', allowed_company_ids)
        ]</field>

        <field name="context">
            {
                'default_is_patient': True,
                'create': False,
                'delete': False,
                'form_view_initial_mode': 'edit',
                'edit': True
            }
        </field>

        <!-- Force correct views -->
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('resonnocare_frontdesk.view_patient_search_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('resonnocare_frontdesk.view_res_partner_patient_form')})
        ]"/>

        <field name="target">current</field>
    </record>

</odoo>
