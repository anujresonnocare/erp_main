<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_resonnocare_supply_docket_upload_wizard_form" model="ir.ui.view">
        <field name="name">resonnocare.supply.docket.upload.wizard.form</field>
        <field name="model">resonnocare.supply.docket.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Docket Upload" create="0" edit="0" delete="0">
                <group>
                    <field name="file_name" invisible="1"/>
                    <field name="file_data" filename="file_name" required="1"/>
                </group>
                <footer>
                    <button name="action_apply_upload" type="object" string="Apply Upload" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
