<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="view_resonnocare_device_tree" model="ir.ui.view">
        <field name="name">resonnocare.device.tree</field>
        <field name="model">resonnocare.device</field>
        <field name="arch" type="xml">
            <list string="Devices">
                <field name="device_code"/>
                <field name="name"/>
                <field name="device_type_id"/>
                <field name="clinic_id"/>
                <field name="status"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_resonnocare_device_form" model="ir.ui.view">
        <field name="name">resonnocare.device.form</field>
        <field name="model">resonnocare.device</field>
        <field name="arch" type="xml">
            <form string="Device">
                <sheet>
                    <group>
                        <group>
                            <field name="device_code"/>
                            <field name="name"/>
                            <field name="device_type_id"/>
                        </group>

                        <group>
                            <field name="clinic_id"/>
                            <field name="status"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_resonnocare_device" model="ir.actions.act_window">
        <field name="name">Devices</field>
        <field name="res_model">resonnocare.device</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
