<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_lot_form_resonnocare_warranty" model="ir.ui.view">
        <field name="name">stock.lot.form.resonnocare.warranty</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="groups_id" eval="[(5, 0, 0)]"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <group string="Device Information">
                    <field name="is_left_ear" string="Left Ear"/>
                    <field name="is_right_ear" string="Right Ear"/>
                </group>
                <group string="Warranty">
                    <field name="warranty_start_date"/>
                    <field name="warranty_end_date"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>



<record id="view_production_lot_form_inherit_fields" model="ir.ui.view">
        <field name="name">stock.production.lot.form.inherit.fields</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <!-- Find the product_id field and add is_left and is_right after it -->
            <xpath expr="//field[@name='product_id']" position="after">

            </xpath>
        </field>
    </record>