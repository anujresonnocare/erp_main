<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="view_resonnocare_device_type_tree" model="ir.ui.view">
        <field name="name">resonnocare.device.type.tree</field>
        <field name="model">resonnocare.device.type</field>
        <field name="arch" type="xml">
            <list string="Device Types">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_resonnocare_device_type_form" model="ir.ui.view">
        <field name="name">resonnocare.device.type.form</field>
        <field name="model">resonnocare.device.type</field>
        <field name="arch" type="xml">
            <form string="Device Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_resonnocare_device_type" model="ir.actions.act_window">
        <field name="name">Device Types</field>
        <field name="res_model">resonnocare.device.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
