<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_product_template_form_resonnocare_warranty" model="ir.ui.view">
        <field name="name">product.template.form.resonnocare.warranty</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="groups_id" eval="[(5, 0, 0)]"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="brand"/>
                <field name="rechargeable"/>
                <field name="item_type"/>
                <field name="item_style"/>
                <field name="item_category"/>
                <field name="hearing_aid_color"/>
                <field name="warranty_months"/>
                <field name="manufacturer_id"/>
                <field name="is_binaural"/>
                <field name="can_number" invisible="item_type != 'ear_mould'"/>
                <field name="color_id"/>
                <field name="vendor_id"/>
                <field name="item_style_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_form_resonnocare_price_history" model="ir.ui.view">
        <field name="name">product.template.form.resonnocare.price.history</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="groups_id" eval="[(5, 0, 0)]"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    class="oe_stat_button"
                    name="action_open_price_history"
                    type="object"
                    icon="fa-line-chart"
                    groups="resonnocare_base.group_resonnocare_super_admin">
                    <field name="price_history_count" string="Price History" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>


       <!-- ===== COLOR ===== -->
    <record id="view_device_color_list" model="ir.ui.view">
        <field name="name">device.color.list</field>
        <field name="model">device.color</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_device_color" model="ir.actions.act_window">
        <field name="name">Colors</field>
        <field name="res_model">device.color</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===== VENDOR ===== -->
    <record id="view_device_vendor_list" model="ir.ui.view">
        <field name="name">device.vendor.list</field>
        <field name="model">device.vendor</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="email"/>
                <field name="phone"/>
            </list>
        </field>
    </record>

    <record id="action_device_vendor" model="ir.actions.act_window">
        <field name="name">Vendors</field>
        <field name="res_model">device.vendor</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===== ITEM STYLE ===== -->
    <record id="view_device_item_style_list" model="ir.ui.view">
        <field name="name">device.item.style.list</field>
        <field name="model">device.item.style</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="action_device_item_style" model="ir.actions.act_window">
        <field name="name">Item Styles</field>
        <field name="res_model">device.item.style</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===== MENU ===== -->
    <menuitem id="menu_device_config"
              name="Device Configuration"
              parent="resonnocare_master.menu_resonnocare_masters"
              sequence="90"/>

    <menuitem id="menu_device_color"
              name="Colors"
              parent="menu_device_config"
              action="action_device_color"
              sequence="10"/>

    <menuitem id="menu_device_vendor"
              name="Vendors"
              parent="menu_device_config"
              action="action_device_vendor"
              sequence="20"/>

    <menuitem id="menu_device_item_style"
              name="Item Styles"
              parent="menu_device_config"
              action="action_device_item_style"
              sequence="30"/>
</odoo>
