<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_clinic_profile" model="ir.ui.view">
        <field name="name">clinic.admin.profile</field>
        <field name="model">resonnocare.clinic</field>
        <field name="arch" type="xml">
            <form string="Clinic Profile" create="false" edit="false" delete="false">
                <sheet>
                    <!-- Force load all fields -->
                    <field name="clinic_code" invisible="1"/>
                    <field name="clinic_type" invisible="1"/>
                    <field name="clinic_subtype" invisible="1"/>
                    <field name="clinic_category" invisible="1"/>
                    <field name="partner_name" invisible="1"/>
                    <field name="clinic_status" invisible="1"/>
                    <field name="go_live_date" invisible="1"/>
                    <field name="ownership_type" invisible="1"/>
                    <field name="street" invisible="1"/>
                    <field name="street2" invisible="1"/>
                    <field name="city" invisible="1"/>
                    <field name="state_id" invisible="1"/>
                    <field name="zip" invisible="1"/>
                    <field name="country_id" invisible="1"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" class="text-break" force_save="0"/>
                        </h1>
                        <h3 class="text-muted">
                            <field name="clinic_code" readonly="1" force_save="0"/>
                        </h3>
                    </div>

                    <group>
                        <group string="Clinic Information">
                            <field name="clinic_type" readonly="1" force_save="0"/>
                            <field name="clinic_subtype" readonly="1" force_save="0"/>
                            <field name="partner_name" readonly="1" invisible="clinic_type == 'coco'" force_save="0"/>
                            <field name="clinic_status" widget="badge" decoration-success="clinic_status == 'active'" decoration-warning="clinic_status == 'draft'" decoration-danger="clinic_status == 'suspended'" force_save="0"/>
                        </group>
                        <group string="Operational Details">
                            <field name="go_live_date" readonly="1" force_save="0"/>
                            <field name="ownership_type" readonly="1" force_save="0"/>
                        </group>
                    </group>

                    <group string="Location">
                        <group>
                            <field name="street" readonly="1" force_save="0"/>
                            <field name="street2" readonly="1" force_save="0"/>
                            <field name="city" readonly="1" force_save="0"/>
                        </group>
                        <group>
                            <field name="state_id" readonly="1" force_save="0"/>
                            <field name="zip" readonly="1" force_save="0"/>
                            <field name="country_id" readonly="1" force_save="0"/>
                        </group>
                    </group>



                    <div class="alert alert-info mt-3" role="alert">
                        <strong>Note:</strong> To modify clinic details, please contact Resonnocare HQ.
                    </div>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_clinic_profile" model="ir.actions.act_window">
        <field name="name">Clinic Profile</field>
        <field name="res_model">resonnocare.clinic</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_clinic_profile"/>
        <field name="target">current</field>
        <field name="context">{
            'form_view_initial_mode': 'readonly',
            'create': False,
            'edit': False,
        }</field>
        <field name="groups_id" eval="[(4, ref('resonnocare_base.group_resonnocare_super_admin'))]"/>
    </record>

</odoo>
