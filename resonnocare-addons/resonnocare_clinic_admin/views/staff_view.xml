<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Simplified Tree View for Clinic Admin -->
    <record id="view_clinic_staff_tree" model="ir.ui.view">
        <field name="name">hr.employee.tree.clinic.admin</field>
        <field name="model">hr.employee</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="job_title"/>
                <field name="clinic_role"/>
                <field name="work_email"/>
                <field name="work_phone"/>
                <field name="department_id"/>
            </list>
        </field>
    </record>

    <!-- Simplified Form View for Clinic Admin -->
    <record id="view_clinic_staff_form" model="ir.ui.view">
        <field name="name">hr.employee.form.clinic.admin</field>
        <field name="model">hr.employee</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Staff Member" create="0" edit="0" delete="0">
                <sheet>
                    <field name="image_1920" widget='image' class="oe_avatar" options='{"zoom": true, "preview_image": "image_128"}'/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Employee's Name" required="True"/>
                        </h1>
                        <h2>
                            <field name="job_title" placeholder="Job Position"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Clinic Details">
                            <field name="clinic_id" readonly="1"/>
                            <field name="clinic_role" readonly="1"/>
                            <field name="department_id" readonly="1"/>
                        </group>
                        <group string="Contact Information">
                            <field name="work_email" widget="email"/>
                            <field name="work_phone" widget="phone"/>
                            <field name="mobile_phone" widget="phone"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Staff Action - Shows only clinic's employees -->
    <record id="action_clinic_staff" model="ir.actions.act_window">
        <field name="name">Staff</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'chat_icon': True, 'create': False, 'edit': False, 'delete': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_clinic_staff_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_clinic_staff_form')})]"/>
        <field name="domain">[]</field>
        <field name="groups_id" eval="[(4, ref('resonnocare_base.group_resonnocare_super_admin'))]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No staff members found
            </p>
            <p>
                Staff records are managed by HR. If you need to add or update staff, please contact the HR department.
            </p>
        </field>
    </record>

</odoo>
