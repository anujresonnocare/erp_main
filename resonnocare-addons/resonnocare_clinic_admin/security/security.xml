<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- Clinic Admin UI Group -->
        <record id="group_clinic_admin_ui" model="res.groups">
            <field name="name">Clinic Admin UI</field>
            <field name="implied_ids" eval="[(4, ref('resonnocare_base.group_clinic_admin'))]"/>
        </record>

        <!-- Rule: Clinic Admin can only access their own clinic's company record -->
        <record id="res_company_rule_clinic_admin_ui" model="ir.rule">
            <field name="name">Clinic Admin UI: Own Clinic Only</field>
            <field name="model_id" ref="base.model_res_company"/>
            <field name="groups" eval="[(4, ref('group_clinic_admin_ui'))]"/>
            <field name="domain_force">[('id', '=', user.company_id.id)]</field>
        </record>

    </data>
</odoo>