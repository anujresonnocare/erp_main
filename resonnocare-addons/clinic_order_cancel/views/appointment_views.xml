                <!-- ORIGINAL APPOINTMENT DETAILS (Visible only in Cancellation Appointment) -->
                <group string="Original Appointment Details" invisible="appointment_type_id.name != 'Order Cancel'">
                    <group>
                        <field name="original_patient_id" readonly="1"/>
                        <field name="original_patient_name" readonly="1"/>
                        <field name="original_clinic_name" readonly="1"/>
                        <field name="original_appointment_date" readonly="1"/>
                    </group>
                    <group>
                        <field name="original_audiologist" readonly="1"/>
                        <field name="original_technician" readonly="1"/>
                        <field name="original_sale_order_name" readonly="1"/>
                        <field name="original_sale_order_amount" readonly="1" widget="monetary"/>
                    </group>
                    <group>
                        <field name="original_device_lines" readonly="1" nolabel="1" 
                               placeholder="No devices in original appointment"/>
                        <field name="original_diagnostic_tests" readonly="1" nolabel="1"
                               placeholder="No diagnostic tests in original appointment"/>
                    </group>
                </group>

                <!-- CANCELLATION DETAILS -->
                <group string="Cancellation Details" invisible="appointment_type_id.name != 'Order Cancel'">
                    <group>
                        <field name="original_appointment_id" 
                               domain="[('sale_order_id', '!=', False), ('status', 'in', ['completed', 'in_consultation'])]"
                               required="appointment_type_id.name == 'Order Cancel'"
                               help="Select the original appointment that is being cancelled"/>
                        <field name="cancellation_status" widget="badge"/>
                    </group>
                    <group>
                        <field name="cancellation_date"/>
                        <field name="cancellation_amount" widget="monetary"/>
                        <field name="cancellation_appointment_ids" readonly="1"/>
                    </group>
                    <group colspan="2">
                        <field name="cancellation_reason" 
                               placeholder="Enter reason for cancellation"/>
                    </group>
                </group>

                <!-- INVOICE DETAILS -->
                <group string="Invoice Details" invisible="not invoice_ids">
                    <field name="invoice_ids" readonly="1" nolabel="1"/>
                </group>

                <!-- ORDER DETAILS -->
                <group string="Order Details" invisible="not cancellation_processed">
                    <field name="sale_order_id" readonly="1"/>
                    <field name="return_order_id" readonly="1"/>
                    <field name="credit_note_id" readonly="1"/>
                </group>

                <!-- EXCHANGE DETAILS -->
