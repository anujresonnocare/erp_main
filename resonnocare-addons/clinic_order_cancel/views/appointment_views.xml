    <!-- EXCHANGE WIZARD FORM VIEW -->
    <record id="view_resonnocare_exchange_wizard_form" model="ir.ui.view">
        <field name="name">resonnocare.exchange.wizard.form</field>
        <field name="model">resonnocare.exchange.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Exchange">
                <sheet>
                    <div class="alert alert-info" role="alert" invisible="amount_difference == 0">
                        <span invisible="amount_difference &gt; 0">
                            <i class="fa fa-warning"/> Customer owes <b><field name="amount_difference" readonly="1" widget="monetary"/></b> for the exchange.
                        </span>
                        <span invisible="amount_difference &lt; 0">
                            <i class="fa fa-check-circle"/> Customer will receive a refund of <b><field name="amount_difference" readonly="1" widget="monetary"/></b>.
                        </span>
                    </div>
                    
                    <group>
                        <group>
                            <field name="cancellation_appointment_id" readonly="1"/>
                            <field name="original_appointment_id" readonly="1"/>
                            <field name="patient_id" readonly="1"/>
                            <field name="clinic_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="return_order_id" readonly="1"/>
                            <field name="return_amount" readonly="1" widget="monetary"/>
                            <field name="new_order_amount" readonly="1" widget="monetary"/>
                            <field name="amount_difference" readonly="1" widget="monetary" 
                                   decoration-danger="amount_difference &lt; 0"
                                   decoration-success="amount_difference &gt; 0"/>
                        </group>
                    </group>
                    
                    <field name="reason" placeholder="Enter reason for exchange..." required="1"/>
                    
                    <group string="Exchange Products">
                        <field name="exchange_line_ids">
                            <list editable="bottom">
                                <field name="product_id" options="{'no_create': True}" required="1"/>
                                <field name="quantity" required="1"/>
                                <field name="price_unit" required="1"/>
                                <field name="subtotal" sum="Total" readonly="1"/>
                            </list>
                        </field>
                    </group>
                    
                    <footer>
                        <button name="action_confirm_exchange" 
                                string="Confirm Exchange" 
                                type="object" 
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- EXTEND APPOINTMENT LIST VIEW -->
    <record id="view_resonnocare_appointment_list_cancel" model="ir.ui.view">
        <field name="name">resonnocare.appointment.list.cancel</field>
        <field name="model">resonnocare.appointment</field>
        <field name="inherit_id" ref="resonnocare_appointment.view_resonnocare_appointment_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='status']" position="after">
                <field name="cancellation_status" 
                       widget="badge"
                       invisible="appointment_type_id.name != 'Order Cancel'"/>
                <field name="cancellation_amount"
                       sum="Total"
                       invisible="appointment_type_id.name != 'Order Cancel'"/>
                <field name="exchange_status" 
                       widget="badge"
                       invisible="appointment_type_id.name != 'Order Cancel' or not exchange_processed"/>
                <field name="original_appointment_id" invisible="1"/>
                <!-- Show original appointment in list for cancellation appointments -->
                <field name="original_appointment_id" 
                       invisible="appointment_type_id.name == 'Order Cancel'"/>
            </xpath>
        </field>
    </record>

    <!-- EXTEND APPOINTMENT SEARCH VIEW -->
    <record id="view_resonnocare_appointment_search_cancel" model="ir.ui.view">
        <field name="name">resonnocare.appointment.search.cancel</field>
        <field name="model">resonnocare.appointment</field>
        <field name="inherit_id" ref="resonnocare_appointment.view_resonnocare_appointment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="cancellation_completed" 
                        string="Cancelled"
                        domain="[('appointment_type_id.name', '=', 'Order Cancel'), ('cancellation_processed', '=', True)]"/>
                <filter name="cancellation_pending" 
                        string="Cancellation Pending"
                        domain="[('appointment_type_id.name', '=', 'Order Cancel'), ('cancellation_processed', '=', False)]"/>
                <filter name="order_cancel_type" 
                        string="Order Cancel"
                        domain="[('appointment_type_id.name', '=', 'Order Cancel')]"/>
                <filter name="original_appointment" 
                        string="Original Appointments"
                        domain="[('appointment_type_id.name', '!=', 'Order Cancel')]"/>
                <filter name="exchange_completed" 
                        string="Exchange Completed"
                        domain="[('exchange_status', '=', 'completed')]"/>
                <filter name="exchange_failed" 
                        string="Exchange Failed"
                        domain="[('exchange_status', '=', 'failed')]"/>
            </xpath>
        </field>
    </record>

    <!-- ACTION FOR EXCHANGE WIZARD -->
    <record id="action_resonnocare_exchange_wizard" model="ir.actions.act_window">
        <field name="name">Create Exchange</field>
        <field name="res_model">resonnocare.exchange.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_resonnocare_exchange_wizard_form"/>
    </record>

