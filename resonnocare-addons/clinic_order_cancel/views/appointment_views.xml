    <!-- EXTEND APPOINTMENT FORM VIEW -->
    <record id="view_resonnocare_appointment_form_cancel" model="ir.ui.view">
        <field name="name">resonnocare.appointment.form.cancel</field>
        <field name="model">resonnocare.appointment</field>
        <field name="inherit_id" ref="resonnocare_appointment.view_resonnocare_appointment_form"/>
        <field name="arch" type="xml">
            
            <!-- Add cancellation and exchange buttons in button box -->
            <xpath expr="//sheet" position="inside">
            <div class="oe_button_box" name="button_box">
                
                <button name="action_view_parent" 
                        string="Parent" 
                        type="object" 
                        class="oe_stat_button"
                        icon="fa-level-up"
                        invisible="not parent_appointment_id"
                        help="Go to parent appointment"/>
                
                <button name="action_view_children" 
                        string="Children" 
                        type="object" 
                        class="oe_stat_button"
                        icon="fa-level-down"
                        invisible="not child_appointment_ids"
                        help="View child appointments"/>
                
                <button name="action_view_previous" 
                        string="Previous" 
                        type="object" 
                        class="oe_stat_button"
                        icon="fa-arrow-left"
                        invisible="not previous_appointment_id"
                        help="Go to previous appointment in journey"/>
                
                <button name="action_view_next" 
                        string="Next" 
                        type="object" 
                        class="oe_stat_button"
                        icon="fa-arrow-right"
                        invisible="not next_appointment_id"
                        help="Go to next appointment in journey"/>
                
                <button name="action_view_root" 
                        string="Root" 
                        type="object" 
                        class="oe_stat_button"
                        icon="fa-home"
                        invisible="not root_appointment_id and root_appointment_id != id"
                        help="Go to root appointment"/>

                <!-- View Fitting Appointments button -->
                <button name="action_view_fitting_appointments" 
                        string="Fitting Appointments"
                        type="object" 
                        class="oe_stat_button"
                        icon="fa-calendar-plus-o"
                        invisible="not fitting_appointment_ids"
                        help="View fitting appointments created from this appointment"/>
                        

                        
                <!-- Create Cancel Appointment button (shows on original appointment with sale order) -->
                <button name="action_create_cancel_appointment" 
                        string="Cancel Order"
                        type="object" 
                        class="oe_stat_button"
                        icon="fa-times-circle"
                        invisible="exchange_order_id or not sale_order_id or status not in ['completed', 'in_consultation'] or has_cancellation_appointment"
                        help="Create a cancellation appointment for this order"/>
                
                <!-- Process Cancellation button (shows on cancellation appointment) -->
                <button name="action_process_cancellation" 
                        string="Process Cancellation"
                        type="object" 
                        class="oe_stat_button"
                        icon="fa-check-circle"
                        invisible="not cancellation_amount or cancellation_processed"
                        help="Process the cancellation, create return and credit note"/>
                
                <!-- View Cancellation Appointments (shows on original appointment) -->
                <button name="action_view_cancellation_appointments" 
                        string="Cancellations"
                        type="object" 
                        class="oe_stat_button"
                        icon="fa-list"
                        invisible="appointment_type_id.name == 'Order Cancel' or not has_cancellation_appointment"
                        help="View cancellation appointments"/>
                
                <!-- View Sale Order -->
                <button name="action_view_sale_order" 
                        string="Sale Order"
                        type="object" 
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        invisible="not sale_order_id or not cancellation_processed"/>
                
                <!-- View Return Order -->
                <button name="action_view_return_order" 
                        string="Return Order"
                        type="object" 
                        class="oe_stat_button"
                        icon="fa-undo"
                        invisible="not return_order_id or not cancellation_processed"/>
                
                <!-- View Credit Note -->
                <button name="action_view_credit_note" 
                        string="Credit Note"
                        type="object" 
                        class="oe_stat_button"
                        icon="fa-file-invoice"
                        invisible="not credit_note_id or not cancellation_processed"/>

                <!-- View Exchange Order -->
                <button name="action_view_exchange_order" 
                        string="Exchange Order"
                        type="object" 
                        class="oe_stat_button"
                        icon="fa-exchange"
                        invisible="not exchange_order_id or not sale_order_id  or status not in ['completed', 'in_consultation'] or has_cancellation_appointment"/>

                <!-- Create Exchange button -->
                <button name="action_create_exchange_wizard" 
                        string="Create Exchange"
                        type="object" 
                        class="oe_stat_button btn-primary"
                        icon="fa-exchange"
                        invisible="exchange_return_order_id or not sale_order_id  or status not in ['completed', 'in_consultation'] or has_cancellation_appointment"/>


            </div>
            </xpath>


                   <xpath expr="//header" position="inside">
                <button name="action_create_hearing_test_appointment" 
                        string="Hearing Test" 
                        type="object" 
                        class="btn-primary"
                        invisible="not sale_order_id"
                        help="Create Hearing Test and Trial appointment"/>
                
                <button name="action_create_device_sale_appointment" 
                        string="Device Sale" 
                        type="object" 
                        class="btn-primary"
                        invisible="not sale_order_id"
                        help="Create Device Sale appointment"/>
                
                <button name="action_create_followup_appointment" 
                        string="Follow-up" 
                        type="object" 
                        class="btn-primary"
                        invisible="not sale_order_id"
                        help="Create Follow-up appointment"/>
            </xpath>


            <!-- Add cancellation fields after appointment_type_id -->
            <xpath expr="//group[2]" position="after">
                
                <!-- Parent Appointment Details (Visible only in Fitting Appointment) -->
                <!-- <group string="Original Appointment Details" invisible="not parent_appointment_id">
