<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_bank_deposit" model="ir.sequence">
        <field name="name">Bank Deposit</field>
        <field name="code">bank.deposit</field>
        <field name="prefix">DEP/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- USER: separate root menu -->
    <menuitem id="menu_cash_root"
              name="My Cash"
              sequence="10"/>

    <menuitem id="menu_cash_entries"
              name="Cash Entries"
              parent="menu_cash_root"
              action="action_cash_payment_entries"
              groups="account.group_account_invoice"
              sequence="10"/>

    <!-- FINANCE: separate root menu -->
    <menuitem id="menu_finance_root"
              name="Finance"
              sequence="20"/>

    <menuitem id="menu_bank_deposits"
              name="Bank Deposits"
              parent="menu_finance_root"
              action="action_bank_deposit_finance"
              groups="cash_deposit_recon.group_finance"
              sequence="10"/>
</odoo>