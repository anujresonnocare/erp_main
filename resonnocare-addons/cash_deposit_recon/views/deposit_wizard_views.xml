        <!-- 1. The Server Action that calls the Python method -->
     <record id="action_server_open_deposit_wizard" model="ir.actions.server">
        <field name="name">Deposit to Bank</field>
        <field name="model_id" ref="account.model_account_payment"/>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
action = records.action_open_deposit_wizard()
        ]]></field>
    </record>
</odoo>