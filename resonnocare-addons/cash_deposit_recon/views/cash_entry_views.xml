<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- USER LIST VIEW: red rows -->
<record id="view_cash_entry_user_list" model="ir.ui.view">
    <field name="name">cash.entry.user.list</field>
    <field name="model">cash.entry</field>
    <field name="arch" type="xml">
        <list decoration-danger="state == 'unreconciled'"
              decoration-warning="state == 'pending'"
              decoration-success="state == 'reconciled'"
              create="1" edit="1">
            <button name="%(cash_deposit_recon.action_deposit_wizard)d"
                    type="action"
                    string="Deposit to Bank"
                    class="btn-primary"/>
            <field name="date"/>
            <field name="name"/>
            <field name="partner_id"/>
            <field name="amount" sum="Total"/>
            <field name="state" widget="badge"
                   decoration-danger="state == 'unreconciled'"
                   decoration-warning="state == 'pending'"
                   decoration-success="state == 'reconciled'"/>
            <field name="deposit_id" optional="hide"/>
        </list>
    </field>
</record>

    <record id="view_cash_entry_user_form" model="ir.ui.view">
        <field name="name">cash.entry.user.form</field>
        <field name="model">cash.entry</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="unreconciled,pending,reconciled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="payment_method"/>
                            <field name="deposit_id" readonly="1"/>
                            <field name="is_red" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- USER ACTION -->
    <record id="action_cash_entry_user" model="ir.actions.act_window">
        <field name="name">Cash Entries</field>
        <field name="res_model">cash.entry</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ['unreconciled','pending','reconciled'])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No cash entries yet</p>
        </field>
    </record>
</odoo>