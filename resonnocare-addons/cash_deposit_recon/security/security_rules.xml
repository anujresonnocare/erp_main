<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_bank_deposit_user" model="ir.rule">
        <field name="name">Bank Deposit: user sees own submissions</field>
        <field name="model_id" ref="model_bank_deposit"/>
        <field name="domain_force">[('submitted_by', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="rule_bank_deposit_finance" model="ir.rule">
        <field name="name">Bank Deposit: finance sees all</field>
        <field name="model_id" ref="model_bank_deposit"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('cash_deposit_recon.group_finance'))]"/>
    </record>
</odoo>