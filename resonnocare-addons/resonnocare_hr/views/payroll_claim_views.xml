<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_resonnocare_payroll_claim_list" model="ir.ui.view">
        <field name="name">resonnocare.payroll.claim.list</field>
        <field name="model">resonnocare.payroll.claim</field>
        <field name="arch" type="xml">
            <list create="1" delete="0">
                <field name="name"/>
                <field name="claim_date"/>
                <field name="employee_id"/>
                <field name="claim_type"/>
                <field name="amount_requested"/>
                <field name="amount_approved"/>
                <field name="state"/>
                <field name="payslip_id"/>
            </list>
        </field>
    </record>

    <record id="view_resonnocare_payroll_claim_form" model="ir.ui.view">
        <field name="name">resonnocare.payroll.claim.form</field>
        <field name="model">resonnocare.payroll.claim</field>
        <field name="arch" type="xml">
            <form string="Payroll Claim">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state not in ('draft','query')"/>
                    <button name="action_mark_query" type="object" string="Raise Query" class="btn-secondary" groups="resonnocare_base.group_resonnocare_hr,resonnocare_base.group_resonnocare_super_admin" invisible="state not in ('submitted','hr_approved')"/>
                    <button name="action_hr_approve" type="object" string="HR Approve" class="btn-primary" groups="resonnocare_base.group_resonnocare_hr,resonnocare_base.group_resonnocare_super_admin" invisible="state not in ('submitted','query')"/>
                    <button name="action_hr_reject" type="object" string="HR Reject" class="btn-secondary" groups="resonnocare_base.group_resonnocare_hr,resonnocare_base.group_resonnocare_super_admin" invisible="state not in ('submitted','query')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-secondary" groups="resonnocare_base.group_resonnocare_hr,resonnocare_base.group_resonnocare_super_admin" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,query,hr_approved,hr_rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="employee_id" readonly="state not in ('draft','query')"/>
                            <field name="claim_date" readonly="state not in ('draft','query')"/>
                            <field name="claim_type" readonly="state not in ('draft','query')"/>
                        </group>
                        <group>
                            <field name="amount_requested" readonly="state not in ('draft','query')"/>
                            <field name="amount_approved" readonly="1" groups="base.group_user"/>
                            <field name="amount_approved" readonly="state not in ('submitted','query')" groups="resonnocare_base.group_resonnocare_hr,resonnocare_base.group_resonnocare_super_admin"/>
                            <field name="is_tax_exempt" readonly="state not in ('submitted','query')"/>
                            <field name="payslip_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="submitted_on" readonly="1"/>
                            <field name="reviewed_on" readonly="1"/>
                            <field name="reviewed_by_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="notes" readonly="state not in ('draft','query')"/>
                            <field name="hr_remarks" readonly="state not in ('submitted','query')"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hr_payslip_form_inherit_resonnocare_snapshot" model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit.resonnocare.snapshot</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" search="[('model', '=', 'hr.payslip'), ('type', '=', 'form')]" />
        <field name="groups_id" eval="[(5, 0, 0)]"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[1]" position="after">
                <group string="Resonnocare Payroll Snapshot">
                    <field name="res_payable_days" readonly="1"/>
                    <field name="res_lop_days" readonly="1"/>
                    <field name="res_approved_claim_amount" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_resonnocare_payroll_claim_my" model="ir.actions.act_window">
        <field name="name">My Reimbursement Claims</field>
        <field name="res_model">resonnocare.payroll.claim</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="context">{}</field>
    </record>

    <record id="action_resonnocare_payroll_claim_hr" model="ir.actions.act_window">
        <field name="name">Payroll Claims (HR Approval)</field>
        <field name="res_model">resonnocare.payroll.claim</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
    </record>

</odoo>
