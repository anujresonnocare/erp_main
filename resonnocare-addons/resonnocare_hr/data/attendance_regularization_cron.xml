<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_regularization_reminder_24h" model="ir.cron">
            <field name="name">Attendance Regularization: 24h Reminder</field>
            <field name="model_id" search="[('model', '=', 'resonnocare.attendance.regularization')]"/>
            <field name="state">code</field>
            <field name="code">model._cron_regularization_reminder()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_regularization_escalation_48h" model="ir.cron">
            <field name="name">Attendance Regularization: 48h Escalation</field>
            <field name="model_id" search="[('model', '=', 'resonnocare.attendance.regularization')]"/>
            <field name="state">code</field>
            <field name="code">model._cron_regularization_escalation()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
