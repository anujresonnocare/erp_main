<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_attendance_evaluation" model="ir.cron">
            <field name="name">Attendance: Daily Evaluation Summary</field>
            <field name="model_id" ref="model_resonnocare_attendance_summary"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_daily_summary()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).replace(hour=1, minute=0, second=0)"/>
        </record>

        <record id="ir_cron_attendance_weekly_regularization_reminder" model="ir.cron">
            <field name="name">Attendance: Weekly Regularization Reminder</field>
            <field name="model_id" ref="model_resonnocare_attendance_summary"/>
            <field name="state">code</field>
            <field name="code">model._cron_weekly_regularization_reminder()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(datetime.now() + timedelta(days=7)).replace(hour=10, minute=0, second=0)"/>
        </record>
    </data>
</odoo>
