<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_attendance_cycle_close" model="ir.cron">
            <field name="name">Attendance: Cycle Closure Lock</field>
            <field name="model_id" ref="model_resonnocare_attendance_summary"/>
            <field name="state">code</field>
            <field name="code">model._cron_close_attendance_cycle()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_attendance_cycle_finalize" model="ir.cron">
            <field name="name">Attendance: Cycle Finalize After Manager Window</field>
            <field name="model_id" ref="model_resonnocare_attendance_summary"/>
            <field name="state">code</field>
            <field name="code">model._cron_finalize_attendance_cycle()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_attendance_salary_day_freeze" model="ir.cron">
            <field name="name">Attendance: Salary Day Freeze</field>
            <field name="model_id" ref="model_resonnocare_attendance_summary"/>
            <field name="state">code</field>
            <field name="code">model._cron_salary_day_freeze()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
