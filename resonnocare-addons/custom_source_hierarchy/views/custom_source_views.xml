<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- list View with Hierarchy Support -->
    <record id="view_custom_source_list" model="ir.ui.view">
        <field name="name">custom.source.list</field>
        <field name="model">custom.source</field>
        <field name="arch" type="xml">
            <list string="Sources" multi_edit="1" decoration-info="is_root==False" decoration-success="is_root==True">
                <field name="code" />
                <field name="name" />
                <field name="parent_id" />
                <field name="level" sum="Level" />
                <field name="children_count" sum="Total Children" />
                <field name="active" />
            </list>
        </field>
    </record>
    
    <!-- Form View -->
    <record id="view_custom_source_form" model="ir.ui.view">
        <field name="name">custom.source.form</field>
        <field name="model">custom.source</field>
        <field name="arch" type="xml">
            <form string="Source">
                <header>
                    <button name="action_view_hierarchy" 
                            type="object" 
                            string="View Hierarchy" 
                            class="oe_highlight" />
                    <button name="action_view_children" 
                            type="object" 
                            string="View Children" 
                            invisible="children_count == 0" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Source Name..." />
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="code" placeholder="Unique Code" />
                            <field name="parent_id" 
                                   domain="[('id', '!=', id)]"
                                   context="{'check_hierarchy_cycle': False}" />
                            <field name="level" readonly="1" />
                            <field name="is_root" readonly="1" />
                        </group>
                        <group>
                            <field name="children_count" readonly="1" />
                            <field name="active" />
                        </group>
                    </group>
                    
                    <group string="Description">
                        <field name="description" placeholder="Add description..." />
                    </group>
                    
                    <group string="Hierarchy Information">
                        <field name="parent_path" readonly="1" />
                        <field name="full_path" 
                               string="Full Path" 
                               readonly="1" />
                    </group>
                    
                    <notebook>
                        <page string="Children" invisible="children_count == 0">
                            <field name="child_ids" context="{'default_parent_id': id}">
                                <list string="Child Sources" editable="bottom">
                                    <field name="code" />
                                    <field name="name" />
                                    <field name="level" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Search View -->
    <record id="view_custom_source_search" model="ir.ui.view">
        <field name="name">custom.source.search</field>
        <field name="model">custom.source</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="code" />
                <field name="parent_id" />
                <filter name="active" 
                        string="Active" 
                        domain="[('active', '=', True)]" />
                <filter name="root" 
                        string="Root Sources" 
                        domain="[('parent_id', '=', False)]" />
                <separator />
                <filter name="level0" 
                        string="Level 0" 
                        domain="[('level', '=', 0)]" />
                <filter name="level1" 
                        string="Level 1" 
                        domain="[('level', '=', 1)]" />
                <filter name="level2" 
                        string="Level 2" 
                        domain="[('level', '=', 2)]" />
                <group expand="0" string="Group By">
                    <filter name="group_parent" 
                            string="Parent" 
                            context="{'group_by': 'parent_id'}" />
                    <filter name="group_level" 
                            string="Level" 
                            context="{'group_by': 'level'}" />
                    <filter name="group_active" 
                            string="Active" 
                            context="{'group_by': 'active'}" />
                </group>
            </search>
        </field>
    </record>

</odoo>