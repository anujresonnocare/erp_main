<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_resonnocare_crm_churn_campaign_list" model="ir.ui.view">
        <field name="name">resonnocare.crm.churn.campaign.list</field>
        <field name="model">resonnocare.crm.churn.campaign</field>
        <field name="arch" type="xml">
            <list string="Churn Campaigns">
                <field name="name"/>
                <field name="lead_id"/>
                <field name="lead_phone"/>
                <field name="lead_source"/>
                <field name="assigned_agent_id"/>
                <field name="disposition_id"/>
                <field name="stage_id"/>
                <field name="tenure_days"/>
                <field name="churned_on"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_resonnocare_crm_churn_campaign_form" model="ir.ui.view">
        <field name="name">resonnocare.crm.churn.campaign.form</field>
        <field name="model">resonnocare.crm.churn.campaign</field>
        <field name="arch" type="xml">
            <form string="Churn Campaign">
                <header>
                    <button name="action_mark_active" type="object" string="Activate" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_mark_closed" type="object" string="Close" class="btn-success" invisible="state not in ('draft', 'active')"/>
                    <button name="action_mark_cancelled" type="object" string="Cancel" class="btn-secondary" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,closed,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="lead_id" readonly="1"/>
                            <field name="assigned_agent_id" readonly="1"/>
                            <field name="lead_phone" readonly="1"/>
                            <field name="lead_source" readonly="1"/>
                        </group>
                        <group>
                            <field name="disposition_id" readonly="1"/>
                            <field name="stage_id" readonly="1"/>
                            <field name="tenure_days" readonly="1"/>
                            <field name="churned_on" readonly="1"/>
                            <field name="interested_clinic_id" readonly="1"/>
                            <field name="preferred_clinic_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Retention or churn recovery notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_resonnocare_crm_churn_campaigns" model="ir.actions.act_window">
        <field name="name">Churn Campaigns</field>
        <field name="res_model">resonnocare.crm.churn.campaign</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_resonnocare_crm_churn_campaigns"
        name="Churn Campaigns"
        parent="crm.crm_menu_sales"
        action="action_resonnocare_crm_churn_campaigns"
        groups="resonnocare_base.group_resonnocare_super_admin,resonnocare_base.group_resonnocare_internal,resonnocare_base.group_crm"
        sequence="45"
    />
</odoo>
