                                    <field name="net_attendance_percent" string="Net Attendance %" />
                                </group>
                                <group string="Hearing Test Metrics">
                                    <field name="hearing_test_opportunity" string="Hearing Test Opportunity"/>
                                    <field name="hearing_test_opportunity_percentage" string="HTO %" />
                                    <field name="conversions_prescriptions" string="Conversions/Prescriptions"/>
                                    <field name="conversion_rate_percent" string="Conversion Rate %" />
                                </group>
                            </group>
                            <group>
                                <group string="Revenue Metrics">
                                    <field name="binaural" string="Binaural Units"/>
                                    <field name="binaural_rate_percentage" string="Binaural Rate %" />
                                    <field name="hearing_unit" string="Hearing Aid Units"/>
                                    <field name="average_selling_price" string="Avg Selling Price"/>
                                    <field name="gross_revenue" string="Gross Revenue"/>
                                    <field name="fitting_revenue" string="Fitting Revenue"/>
                                </group>
