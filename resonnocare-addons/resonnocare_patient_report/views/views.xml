                            <field name="is_total_row" string="Total Row"/>
                            <field name="is_area_manager_total" string="Area Manager Total"/>
                            <field name="is_region_total" string="Region Total"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Summary Metrics Tab -->
                        <page string="Summary Metrics">
                            <group>
                                <group string="Appointments">
                                    <field name="total_appointments" string="Total Appointments"/>
                                    <field name="total_diagnostic_appointments" string="Total Diagnostic Appointments"/>
                                    <field name="hearing_test_booked" string="Hearing Test Booked"/>
