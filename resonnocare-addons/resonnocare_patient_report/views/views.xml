                            type="object" 
                            class="btn-secondary"
                            icon="fa-calendar"/>
                    <button name="generate_wtd_report" 
                            string="Generate WTD" 
                            type="object" 
                            class="btn-secondary"
                            icon="fa-calendar"/>
                    <button name="generate_yesterday_report" 
                            string="Generate Yesterday" 
                            type="object" 
                            class="btn-secondary"
                            icon="fa-calendar"/>
                    <button name="generate_all_reports" 
                            string="Generate All Reports" 
                            type="object" 
                            class="btn-warning"
                            icon="fa-list"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="date_from" string="Date From"/>
                            <field name="date_to" string="Date To"/>
                            <field name="report_type" string="Report Type"/>
                        </group>
                        <group>
                            <field name="clinic_name" string="Clinic Name"/>
                            <field name="clinic_code" string="Clinic Code"/>
                            <field name="clinic_status" string="Clinic Status"/>
                        </group>
                    </group>

                    <group>
                        <group>
                            <field name="area_manager_name" string="Area Manager"/>
                            <field name="region" string="Region"/>
                            <field name="state" string="State"/>
                            <field name="city" string="City"/>
                        </group>
                        <group>
