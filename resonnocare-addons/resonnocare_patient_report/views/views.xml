        <field name="name">cdt.journey.report.form</field>
        <field name="model">cdt.journey.report</field>
        <field name="arch" type="xml">
            <form string="CDT Journey Report">
                  <header>
                    <button name="generate_report" 
                            string="Generate Report" 
                            type="object" 
                            class="btn-primary"
                            icon="fa-file-pdf-o"/>
                    <button name="generate_ytd_report" 
                            string="Generate YTD" 
                            type="object" 
                            class="btn-secondary"
                            icon="fa-calendar"/>
                    <button name="generate_mtd_report" 
