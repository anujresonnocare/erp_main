<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="db_cleaner_cron_failure_view_tree" model="ir.ui.view">
    <field name="name">db.cleaner.cron.failure.tree</field>
    <field name="model">db.cleaner.cron.failure</field>
    <field name="arch" type="xml">
      <list default_order="severity desc, last_call asc" string="Cron Issues">
        <field name="cron_name"/>
        <field name="model_name"/>
        <field name="issue" widget="badge"/>
        <field name="severity" widget="badge"
               decoration-info="severity == 'info'"
               decoration-warning="severity == 'warning'"
               decoration-danger="severity == 'error'"/>
        <field name="last_call"/>
        <field name="next_call"/>
        <field name="is_active" widget="boolean_toggle"/>
        <field name="scan_id" optional="hide"/>
        <button name="action_open_cron" type="object"
                string="Open" icon="fa-external-link"/>
        <button name="action_run_now" type="object"
                string="Run Now" icon="fa-play"
                invisible="not is_active"/>
        <button name="action_reactivate" type="object"
                string="Reactivate" icon="fa-refresh"
                invisible="is_active"/>
      </list>
    </field>
  </record>

  <record id="db_cleaner_cron_failure_view_search" model="ir.ui.view">
    <field name="name">db.cleaner.cron.failure.search</field>
    <field name="model">db.cleaner.cron.failure</field>
    <field name="arch" type="xml">
      <search>
        <field name="cron_name"/>
        <filter name="filter_error" string="Errors"
                domain="[('severity', '=', 'error')]"/>
        <filter name="filter_warning" string="Warnings"
                domain="[('severity', '=', 'warning')]"/>
        <filter name="filter_inactive" string="Inactive"
                domain="[('is_active', '=', False)]"/>
        <group>
          <filter name="groupby_issue" string="Issue"
                  context="{'group_by': 'issue'}"/>
          <filter name="groupby_severity" string="Severity"
                  context="{'group_by': 'severity'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="db_cleaner_cron_failure_action" model="ir.actions.act_window">
    <field name="name">Cron Failures</field>
    <field name="res_model">db.cleaner.cron.failure</field>
    <field name="view_mode">list</field>
  </record>

</odoo>
