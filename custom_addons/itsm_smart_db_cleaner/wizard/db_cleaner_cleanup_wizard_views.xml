<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="db_cleaner_cleanup_wizard_view_form" model="ir.ui.view">
    <field name="name">db.cleaner.cleanup.wizard.form</field>
    <field name="model">db.cleaner.cleanup.wizard</field>
    <field name="arch" type="xml">
      <form string="Safe Cleanup">
        <sheet>
          <div invisible="state == 'done'">
            <div class="alert alert-info" role="alert"
                 invisible="not simulation">
              <strong>Simulation mode</strong> is enabled. No record will be
              removed; the wizard will only report what would be deleted.
            </div>
            <div class="alert alert-warning" role="alert"
                 invisible="simulation">
              <strong>Simulation mode is OFF.</strong> Records will be
              permanently deleted. Make sure you have a recent backup before
              proceeding.
            </div>
            <group>
              <field name="scan_id" readonly="1"/>
              <field name="simulation"/>
            </group>
            <group string="What to clean">
              <group>
                <field name="clean_orphan_attachments"/>
                <field name="clean_old_logs"/>
                <field name="log_retention_days"
                       invisible="not clean_old_logs"/>
              </group>
              <group>
                <field name="clean_old_mail"/>
                <field name="mail_retention_days"
                       invisible="not clean_old_mail"/>
                <field name="clean_failed_mails"/>
                <field name="vacuum_analyze"/>
              </group>
            </group>
          </div>
          <div invisible="state != 'done'">
            <field name="summary" widget="html" readonly="1"/>
            <group>
              <group>
                <field name="orphan_count" readonly="1"/>
                <field name="orphan_size_mb" readonly="1"/>
              </group>
              <group>
                <field name="log_count" readonly="1"/>
                <field name="mail_count" readonly="1"/>
                <field name="failed_mail_count" readonly="1"/>
              </group>
            </group>
          </div>
        </sheet>
        <footer>
          <button name="action_preview" type="object"
                  string="Preview (Simulation)"
                  class="btn-secondary"
                  invisible="state == 'done'"/>
          <button name="action_execute" type="object"
                  string="Execute"
                  class="btn-primary"
                  invisible="state == 'done'"
                  confirm="This action will permanently delete records if simulation mode is OFF. Continue?"/>
          <button string="Close" class="btn-secondary" special="cancel"/>
        </footer>
        <field name="state" invisible="1"/>
      </form>
    </field>
  </record>

</odoo>
