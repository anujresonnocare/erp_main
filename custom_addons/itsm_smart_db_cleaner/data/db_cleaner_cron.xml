<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_db_cleaner_scan" model="ir.cron">
            <field name="name">Smart DB Cleaner: Periodic Scan</field>
            <field name="model_id" ref="model_db_cleaner_scan"/>
            <field name="state">code</field>
            <field name="code">model.cron_periodic_scan()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="False"/>
        </record>

        <record id="ir_cron_db_cleaner_backup_reminder" model="ir.cron">
            <field name="name">Smart DB Cleaner: Backup Reminder</field>
            <field name="model_id" ref="model_db_cleaner_backup_reminder"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
