                    </t>

                </span>

            </div>

            <!-- Credit -->

            <div style="margin-left : 20px;">

                <span class="fw-bold">أجل</span>

                <span class="checkbox ms-2"/>

            </div>

        </div>

    </div>

    <div class="col-2"  style="height : 42px;">

        <div class="section-label">

            نوع الصرف

        </div>

    </div>

</div>

<!-- ================= AMOUNT IN WORDS ================= -->

<div class="row mb15">

    <div class="col-9">

        <div class="field-box" style="height:42px;">

            <div style="padding : 5px">

