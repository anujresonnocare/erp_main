<?xml version="1.0" encoding="UTF-8"?>
<odoo>

<template id="payment_voucher_report">


<t t-call="web.html_container">
    
    <style>
        .o_standard_footer,
        .o_standard_header {
            display: none !important;
        }
        
        @page {
            size: A4;
            margin: 3mm;
        }
    </style>


<t t-foreach="docs" t-as="o">

<t t-call="web.basic_layout">


<style>



@font-face {
    font-family: 'Cairo';
    src: url('/account_payment_voucher/static/fonts/Cairo-Regular.ttf') format('truetype');
    font-weight: normal;
}

@font-face {
    font-family: 'Cairo';
    src: url('/account_payment_voucher/static/fonts/Cairo-Bold.ttf') format('truetype');
    font-weight: bold;
}

body,
.page,
table,
div,
span,
p,
td,
th {
    font-family: 'Cairo' !important;
}



@page{
    size:A4;
    margin:8mm;
}

body{
    font-family:'DejaVu Sans','Arial',sans-serif;
    font-size:14px;
    color:#222;
}

.page{
    width:100%;
}

.voucher{
    width:100%;
}

.gold-border{
    border:2px solid #b58a2a;
    border-radius:8px;
    
}


.box{
    height:55px;
    padding:6px 10px;
}

.field-box{
    height:42px;
    border:1px solid #d8d8d8;
    border-radius:6px;
    background:#fff;
}

.section-label{
    text-align : center;
    width:140px;
    height : 42px;
    background:#fff;
    border:2px solid #b58a2a;
    border-radius:8px;
    font-weight:bold;
    font-size:17px;
    display:flex;
    align-items:center;
    justify-content:center;
}

.company-name{
    font-size:28px;
    font-weight:700;
}

.company-sub{
    font-size:14px;
    color:#444;
}

.title{
    font-size:34px;
    font-weight:700;
    text-align:center;
}

.small-title{
    font-size:16px;
    font-weight:bold;
    color:#555;
}

.value{
    font-size:22px;
    font-weight:bold;
    color:#b00000;
}

.gold{
    color:#b58a2a;
}

.line{
    border-top:3px solid #222;
    margin-top:12px;
    margin-bottom:16px;
}

.text-right{
    text-align:right;
}

.text-center{
    text-align:center;
}

.mt5{margin-top:5px;}
.mt10{margin-top:10px;}
.mt15{margin-top:15px;}
.mt20{margin-top:20px;}

.mb5{margin-bottom:5px;}
.mb10{margin-bottom:10px;}
.mb15{margin-bottom:15px;}

.rtl{
    direction:rtl;
}

.logo{
    max-height:75px;
    max-width:120px;
}

.invoice-value{
    margin-top:8px;
    font-size:14px;
    font-weight:bold;
}

.date-value{
    margin-top:8px;
    font-size:18px;
}

.checkbox{
    width:18px;
    height:18px;
    border:2px solid #444;
    display:inline-block;
}

.signature-line{
    border-bottom:2px solid #b58a2a;
    width:260px;
    margin-top:55px;
}

</style>

<div class="page" style="font-family: 'Cairo', sans-serif;">


<div class="voucher">

<!-- ================= HEADER ================= -->

<div class="row align-items-center">

    <!-- Invoice Number -->

    <div class="col-2 gold-border" style="height: 80px;">

        <div class=" box text-center">

            <div class="small-title">
                رقم الفاتورة
            </div>

            <div class="invoice-value">

                <span t-field="o.name"/>

            </div>

        </div>

    </div>

    <!-- Date -->

    <div class="col-2 gold-border" style="height: 80px;">

        <div class=" box text-center">

            <div class="small-title">
                تاريخ الفاتورة
            </div>

            <div class="date-value">

                <span t-field="o.date"/>

            </div>

        </div>

    </div>

    <!-- Title -->

    <div class="col-3 text-center">

        <div class="title">
            <t t-if="o.payment_type == 'inbound'">

            فاتورة صرف
            
            </t>
            
            <t t-else="">
                فاتورة قبض
            </t>

        </div>

    </div>

    <!-- Company -->

    <div class="col-4 text-right">

        <div>

            <h3>
            شركة الأندلس للتجارة العامة والمقاولات 
            </h3>

        </div>

        <div class="company-sub">

            <span>AL-ANDALUS Co. | General Trading &amp; Contracts</span>

        </div>

    </div>

    <!-- Logo -->

    <div class="col-1 text-center">

        <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" class="logo"/>

    </div>

</div>

<div class="line"/>

