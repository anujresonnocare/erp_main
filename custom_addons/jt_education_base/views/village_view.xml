<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>

        <!-- StudentSubject Form View-->
        <record id="student_village_form_view" model="ir.ui.view">
            <field name="name">Student Village Form View</field>
            <field name="model">village.village</field>
            <field name="arch" type="xml">
                <form>
                	<sheet>
                		<group>
                			<group>
		                		<field name = "name" required='1'/>
                               <!--  <field name = "province_id" required='1'/>
                                <field name = "dis_id"/>
                                <field name = "state"/>
                                <field name = "country"/> -->
		                	</group>
		                </group>
                	</sheet>
                    <!-- Chatter -->
                     <chatter/>
                </form>
            </field>
        </record>

        <!--StudentSubject List View-->
        <record id="student_village_list_view" model="ir.ui.view">
            <field name="name">Student Village List View</field>
            <field name="model">village.village</field>
            <field name="arch" type="xml">
                <list>
                    <field name = "name"/>
                  <!--   <field name = "province_id"/>
                    <field name = "dis_id"/>  -->
                </list>
            </field>
        </record>

        <record id="action_student_village" model="ir.actions.act_window">
            <field name="name">Student Village</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">village.village</field>
            <field name="view_mode">list,form</field>
	    </record>
    </data>
</odoo>