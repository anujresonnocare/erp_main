<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>

        <!-- Medium Form View-->
        <record id="medium_medium_form_view" model="ir.ui.view">
            <field name="name">Medium Form View</field>
            <field name="model">medium.medium</field>
            <field name="arch" type="xml">
                <form>
                	<sheet>
                		<group>
                			<group>
		                		<field name = "name" required="1"/>
		                	</group>
		                </group>
                	</sheet>
                    <!-- Chatter -->
                     <chatter/>
                </form>
            </field>
        </record>

        <!--Medium List View-->
        <record id="medium_medium_list_view" model="ir.ui.view">
            <field name="name">Medium Tree View</field>
            <field name="model">medium.medium</field>
            <field name="arch" type="xml">
                <list>
                    <field name = "name"/>
                </list>
            </field>
        </record>
    </data>
</odoo>